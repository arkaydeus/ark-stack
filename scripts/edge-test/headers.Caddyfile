# Test-only Caddyfile for `mise run test:edge` (header stripping and Via/Server removal).
# The snippets reproduce `ark_route_base` and `ark_upstream` from docs/design/front-door.md §3.5.
# Sites are plain HTTP on separate ports so the host test client can reach each one directly;
# TLS behaviour is covered by certificate.Caddyfile.
{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		protocols h1 h2
	}
}

(ark_route_base) {
	header {
		-Server
		-Via
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		defer
	}
	request_header -X-Ark-*
	handle_errors 502 503 504 {
		header -Server
		root * /etc/caddy/errors
		rewrite * /{err.status_code}.html
		file_server
	}
}

(ark_upstream) {
	header_up Cookie "(^|;\s*)__Host-ark_gate[^;]*" ""
	header_down -Server
	header_down Set-Cookie "(?i);\s*domain=[^;]*" ""
	flush_interval -1
	stream_close_delay 5m
	transport http {
		dial_timeout 5s
		response_header_timeout 60s
		keepalive 90s
	}
}

# Public route (access: public): the §3.5 upstream block without forward_auth.
:8080 {
	import ark_route_base
	handle /.ark/gate/* {
		respond 404
	}
	handle {
		reverse_proxy upstream:3000 {
			import ark_upstream
			header_down Location "(?i)^(?:https?:)?//(?:100\.101\.102\.103|home\.tail1234\.ts\.net\.?)(?::3000)?([/?#].*|$)" "https://www.example.com${1}"
		}
	}
}

# SSO route: forward_auth copies the gate identity after client-forged X-Ark-* is removed.
:8081 {
	import ark_route_base
	handle {
		forward_auth upstream:3000 {
			uri /auth
			copy_headers X-Ark-User X-Ark-Email
		}
		reverse_proxy upstream:3000 {
			import ark_upstream
		}
	}
}

# Apex route: canonical redirect generated by Caddy itself.
:8082 {
	import ark_route_base
	redir https://www.example.com{uri} 308
}

# Unreachable upstream: the static 502 page from handle_errors.
:8083 {
	import ark_route_base
	reverse_proxy upstream:3999 {
		import ark_upstream
	}
}

# Control: `header_down -Via` alone, without the deferred site-level header.
# Caddy >= 2.10 adds Via after header_down runs, so Via must still appear here.
:8084 {
	reverse_proxy upstream:3000 {
		header_down -Server
		header_down -Via
	}
}
