# Test-only Caddyfile for `mise run test:edge` (certificate reload, §3.14 of docs/design/front-door.md).
# The certificate directory is a writable host directory mounted read-only, so the harness can swap
# the files and then `/load` this exact text with and without `Cache-Control: must-revalidate`.
{
	admin 0.0.0.0:2019
	auto_https disable_redirects
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
	}
}

https://edge.test:8443 {
	tls /certs/fullchain.pem /certs/privkey.pem
	respond "certificate fixture" 200
}
