# Platform PostgreSQL — required to run the stack.
ARK_CONTROL_DB_PASSWORD=change-me-control-database-password
ARK_APP_DB_PASSWORD=change-me-application-database-password
ARK_API_DB_PASSWORD=change-me-api-database-password
DATABASE_URL=postgres://ark_runtime:change-me-api-database-password@127.0.0.1:5433/ark_platform

# Better Auth. Use an exact HTTPS origin in production.
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
ARK_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Authenticated encryption for operational secrets. Mounted outside the control database.
ARK_ROOT_KEY=change-me-to-at-least-32-characters-long
ARK_ROOT_KEY_ID=k1

# Single-use bootstrap token printed by the installer / recovery CLI.
ARK_SETUP_TOKEN=dev-setup-token

# Independent worker identities. Never reuse the setup token.
ARK_INTERNAL_TOKEN=dev-internal-token
ARK_DATABASE_WORKER_TOKEN=dev-database-worker-token
ARK_DOMAIN_WORKER_TOKEN=dev-domain-worker-token
ARK_MAIL_WORKER_TOKEN=dev-mail-worker-token
ARK_BACKUP_WORKER_TOKEN=dev-backup-worker-token
ARK_AGENT_TOKEN=dev-agent-token
ARK_MAINTENANCE_TOKEN=dev-maintenance-token
ARK_MFA_RECOVERY_TOKEN=dev-mfa-recovery-token
ARK_METRICS_TOKEN=dev-metrics-token
ARK_OFFHOST_HEARTBEAT_TOKEN=dev-offhost-heartbeat-token
ARK_OFFHOST_HEARTBEAT_URL=

# Development runs the coordinator inside the API process.
ARK_EMBEDDED_WORKERS=1
ARK_LISTEN_PORT=3000

# Accept expected DNS records without public lookups during local development.
ARK_DNS_STUB=1

# Application PostgreSQL cluster — separate from the control-plane database.
DATABASE_APP_URL=postgres://ark_cluster_admin:change-me-application-database-password@127.0.0.1:5434/postgres
STALWART_ADMIN_ADDRESS=admin
STALWART_ADMIN_PASSWORD=change-me-stalwart-admin-password
ARK_CERT_DIR=./tmp/certs
ARK_COMPOSE_DIR=./tmp/compose
ARK_MAIL_STATE_DIR=./tmp/mail-state
ARK_PGBOUNCER_DIR=./tmp/pgbouncer
ARK_EDGE_DIR=./tmp/edge
# Safe default: staging certificates are untrusted and are not served by the public edge.
# Set to 0 for production issuance, then reissue certificates before switching admin to public.
ARK_ACME_STAGING=1
# Explicit local-only certificate fallback. Production must remove this and configure lego/email.
ARK_CERTIFICATE_MODE=development

# Optional live providers. Incoming mail does not require these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# DNS_API_TOKEN=
# STALWART_URL=http://127.0.0.1:8080
# STALWART_ADMIN_ADDRESS=
# STALWART_ADMIN_PASSWORD=
# STALWART_CLI=
# ARK_ALERT_WEBHOOK=
# ARK_BACKUP_EXECUTE=0
# ARK_PGBOUNCER_RELOAD=0
