FROM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ark-agent .

FROM docker:28.4.0-cli@sha256:6a73c9433f2ba4279815be1e60f5739288b939dda1e48151d8c393537802de37
RUN apk add --no-cache docker-cli-compose ca-certificates
COPY --from=build /out/ark-agent /usr/local/bin/ark-agent
ENTRYPOINT ["/usr/local/bin/ark-agent"]
