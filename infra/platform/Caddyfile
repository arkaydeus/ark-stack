{
  admin edge-admin:2019
}

:80 {
  log
  @otherRequests not path /.well-known/ark-ipv6-preflight/*
  log_skip @otherRequests
  @challenge path /.well-known/acme-challenge/*
  handle @challenge {
    root * /var/lib/ark/acme
    file_server
  }
  handle {
    respond "Ark Stack challenge edge" 404
  }
}

# Public admin routes are written by edge.apply only when admin mode is public.
